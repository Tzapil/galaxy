{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galaxy-sim.local/schema/personalities.schema.json",
  "title": "PersonalitiesFile",
  "type": "object",
  "required": ["version", "personalities"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "personalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "weights"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": { "type": "string", "minLength": 1 },
          "weights": {
            "type": "object",
            "required": [
              "growth",
              "industry",
              "research",
              "military",
              "logistics",
              "stockpile",
              "risk"
            ],
            "additionalProperties": false,
            "properties": {
              "growth": { "type": "number", "minimum": 0 },
              "industry": { "type": "number", "minimum": 0 },
              "research": { "type": "number", "minimum": 0 },
              "military": { "type": "number", "minimum": 0 },
              "logistics": { "type": "number", "minimum": 0 },
              "stockpile": { "type": "number", "minimum": 0 },
              "risk": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
